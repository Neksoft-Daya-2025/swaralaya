                'read' => false,
                'createdAt' => now_iso()
            ];
            try {
                $item['adminEmailSent'] = true;
                $item['adminEmailResult'] = send_admin_notification(
                    $data,
                    'New Swaralaya Enrollment',
                    "New enrollment received.\n\nName: {$studentName}\nEmail: {$studentEmail}\nPhone: {$studentPhone}\nCourse: {$courseName}\nAge: " . trim((string)($item['age'] ?? '')) . "\nExperience: " . trim((string)($item['experience'] ?? '')) . "\n\nMessage:\n" . trim((string)($item['message'] ?? '')),
                    $adminEmail
                );
            } catch (Throwable $error) {
                $item['adminEmailSent'] = false;
                $item['adminEmailError'] = $error->getMessage();
            }
        }
        if ($key === 'bookings') {
            $item['status'] = $item['status'] ?? 'pending';
            $data['notifications'][] = [
                'id' => next_id($data['notifications'] ?? []),
                'type' => 'booking',
                'title' => 'New booking',
                'message' => trim((string)($item['quantity'] ?? '1')) . ' ticket booked for ' . trim((string)($item['eventTitle'] ?? $item['event'] ?? 'Swaralaya event')),
                'read' => false,
                'createdAt' => now_iso()
            ];
            try {
                $item['adminEmailSent'] = true;
                $item['adminEmailResult'] = send_admin_notification(
                    $data,
                    'New Swaralaya Event Booking',
                    "New booking received.\n\nName: " . trim((string)($item['customerName'] ?? $item['name'] ?? '')) . "\nEmail: " . trim((string)($item['customerEmail'] ?? $item['email'] ?? '')) . "\nPhone: " . trim((string)($item['customerPhone'] ?? $item['phone'] ?? '')) . "\nEvent: " . trim((string)($item['eventTitle'] ?? $item['event'] ?? 'Swaralaya event')) . "\nTickets: " . trim((string)($item['quantity'] ?? '1')),
                    $adminEmail
                );
            } catch (Throwable $error) {
                $item['adminEmailSent'] = false;
                $item['adminEmailError'] = $error->getMessage();
            }
        }
        if ($key === 'contacts') {
            try {
                $item['adminEmailSent'] = true;
                $item['adminEmailResult'] = send_admin_notification(
                    $data,
                    'New Swaralaya Contact Message',
                    "New contact message received.\n\nName: " . trim((string)($item['name'] ?? '')) . "\nEmail: " . trim((string)($item['email'] ?? '')) . "\nPhone: " . trim((string)($item['phone'] ?? '')) . "\nSubject: " . trim((string)($item['subject'] ?? '')) . "\n\nMessage:\n" . trim((string)($item['message'] ?? '')),
                    $adminEmail
                );
            } catch (Throwable $error) {
                $item['adminEmailSent'] = false;
                $item['adminEmailError'] = $error->getMessage();
            }
        }
        $data[$key][] = $item;
        save_data($dataFile, $data);
        json_response(201, is_v1($path) ? ['data' => $item] : $item);
    }
}

if (preg_match('#^/api/(?:v1/)?(contacts|enrollments|bookings|blogs|events)/(\\d+)(?:/(read))?$#', $path, $matches)) {
    $key = $matches[1];
    $id = (int) $matches[2];
    foreach ($data[$key] ?? [] as $index => $item) {
        if ((int)($item['id'] ?? 0) === $id) {
            if ($method === 'DELETE') {
                array_splice($data[$key], $index, 1);
                save_data($dataFile, $data);
                json_response(200, ['message' => 'Deleted successfully.']);
            }
            if (in_array($method, ['PUT', 'PATCH'], true)) {
                $data[$key][$index] = array_merge($item, $body, ['updatedAt' => now_iso()]);
                if (($matches[3] ?? '') === 'read') {
                    $data[$key][$index]['read'] = true;
                }
                save_data($dataFile, $data);
                json_response(200, is_v1($path) ? ['data' => $data[$key][$index]] : $data[$key][$index]);
            }
            json_response(200, is_v1($path) ? ['data' => $item] : $item);
        }
    }
    json_response(404, ['message' => 'Not found.']);
}

if (($path === '/api/blogs/upload-image' || $path === '/api/v1/blogs/upload-image') && $method === 'POST') {
    json_response(200, is_v1($path) ? ['data' => ['url' => '/blog-1.webp']] : ['url' => '/blog-1.webp']);
}

json_response(404, ['message' => 'API route not found.', 'path' => $path]);
