}

function clean_smtp(array $smtp): array
{
    unset($smtp['password']);
    $smtp['has_password'] = true;
    return $smtp;
}

function now_iso(): string
{
    return gmdate('c');
}

function next_id(array $items): int
{
    $max = 0;
    foreach ($items as $item) {
        $id = isset($item['id']) ? (int) $item['id'] : 0;
        if ($id > $max) {
            $max = $id;
        }
    }
    return $max + 1;
}

function smtp_recipients(array $smtp, string $fallback): array
{
    $raw = $smtp['admin_emails'] ?? [$fallback];
    if (is_string($raw)) {
        $raw = preg_split('/[,;\s]+/', $raw) ?: [];
    }
    if (!is_array($raw)) {
        $raw = [];
    }
    $emails = array_values(array_unique(array_filter(array_map(
        fn($email) => trim((string) $email),
        $raw
    ), fn($email) => filter_var($email, FILTER_VALIDATE_EMAIL))));
    return $emails ?: [$fallback];
}

function smtp_read($socket): string
{
    $response = '';
    while (($line = fgets($socket, 515)) !== false) {
        $response .= $line;
        if (preg_match('/^\d{3}\s/', $line)) {
            break;
        }
    }
    return $response;
}

function smtp_expect($socket, array $codes, string $context): string
{
    $response = smtp_read($socket);
    $code = (int) substr($response, 0, 3);
    if (!in_array($code, $codes, true)) {
        throw new RuntimeException($context . ' failed: ' . trim($response));
    }
    return $response;
}

function smtp_command($socket, string $command, array $codes, string $context): string
{
    fwrite($socket, $command . "\r\n");
    return smtp_expect($socket, $codes, $context);
}

function smtp_send_mail(array $smtp, array $to, string $subject, string $text, string $fallbackFrom): array
{
    $host = trim((string) ($smtp['host'] ?? 'smtp.office365.com'));
    $port = (int) ($smtp['port'] ?? 587);
    $username = trim((string) ($smtp['username'] ?? $smtp['user'] ?? $fallbackFrom));
    $password = (string) ($smtp['password'] ?? '');
    $fromEmail = trim((string) ($smtp['from_email'] ?? $smtp['fromEmail'] ?? $username));
    if ($fromEmail === '') {
        $fromEmail = $fallbackFrom;
    }
    $fromName = trim((string) ($smtp['from_name'] ?? $smtp['fromName'] ?? 'Swaralaya School of Music'));

    if ($host === '' || $username === '' || $password === '' || !filter_var($fromEmail, FILTER_VALIDATE_EMAIL)) {
        throw new RuntimeException('SMTP settings are incomplete.');
    }

    $remote = (($smtp['encryption'] ?? '') === 'ssl' || $port === 465 ? 'ssl://' : '') . $host . ':' . $port;
    $errno = 0;
    $errstr = '';
    $socket = stream_socket_client($remote, $errno, $errstr, 20, STREAM_CLIENT_CONNECT);
    if (!$socket) {
        throw new RuntimeException("Could not connect to SMTP server: {$errstr}");
    }
    stream_set_timeout($socket, 20);

    try {
        smtp_expect($socket, [220], 'SMTP greeting');
        smtp_command($socket, 'EHLO swaralayaschoolofmusic.nl', [250], 'EHLO');
        if ((($smtp['encryption'] ?? 'tls') === 'tls') && $port !== 465) {
            smtp_command($socket, 'STARTTLS', [220], 'STARTTLS');
            if (!stream_socket_enable_crypto($socket, true, STREAM_CRYPTO_METHOD_TLS_CLIENT)) {
                throw new RuntimeException('Could not enable SMTP TLS.');
            }
            smtp_command($socket, 'EHLO swaralayaschoolofmusic.nl', [250], 'EHLO after TLS');
        }
        smtp_command($socket, 'AUTH LOGIN', [334], 'SMTP auth');
        smtp_command($socket, base64_encode($username), [334], 'SMTP username');
        smtp_command($socket, base64_encode($password), [235], 'SMTP password');
        smtp_command($socket, 'MAIL FROM:<' . $fromEmail . '>', [250], 'MAIL FROM');
        foreach ($to as $recipient) {
            smtp_command($socket, 'RCPT TO:<' . $recipient . '>', [250, 251], 'RCPT TO');
        }
        smtp_command($socket, 'DATA', [354], 'DATA');

        $safeSubject = preg_replace('/[\r\n]+/', ' ', $subject);
        $encodedSubject = '=?UTF-8?B?' . base64_encode($safeSubject) . '?=';
        $safeFromName = addcslashes($fromName, "\\\"");
        $body = str_replace(["\r\n", "\r"], "\n", $text);
        $body = preg_replace('/^\./m', '..', $body);
        $message = [
            'From: "' . $safeFromName . '" <' . $fromEmail . '>',
            'To: ' . implode(', ', $to),
            'Subject: ' . $encodedSubject,
            'MIME-Version: 1.0',
            'Content-Type: text/plain; charset=UTF-8',
            'Content-Transfer-Encoding: 8bit',
            '',
            $body,
        ];
        fwrite($socket, implode("\r\n", $message) . "\r\n.\r\n");
        smtp_expect($socket, [250], 'SMTP send');
        smtp_command($socket, 'QUIT', [221, 250], 'QUIT');
    } finally {
        fclose($socket);
    }

    return ['sent' => true, 'to' => $to];
}

function send_admin_notification(array $data, string $subject, string $text, string $fallbackEmail, ?string $recipient = null): array
{
    $smtp = is_array($data['smtp'] ?? null) ? $data['smtp'] : [];
    $to = $recipient && filter_var($recipient, FILTER_VALIDATE_EMAIL)
        ? [$recipient]
        : smtp_recipients($smtp, $fallbackEmail);
    return smtp_send_mail($smtp, $to, $subject, $text, $fallbackEmail);
}

